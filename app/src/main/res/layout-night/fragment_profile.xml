<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Профиль"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Карточка информации -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            android:background="#2C2C2C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Личная информация"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#A5D6A7"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/userName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Имя пользователя"
                    android:text="Петр Иванов"
                    android:padding="14dp"
                    android:background="#1E1E1E"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/userPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Телефон"
                    android:text="+7 999 123-45-67"
                    android:padding="14dp"
                    android:background="#1E1E1E"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/userEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:text="user@coop.ru"
                    android:inputType="textEmailAddress"
                    android:padding="14dp"
                    android:background="#1E1E1E"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Карточка курятников -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            android:background="#2C2C2C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏠 Мои курятники"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#A5D6A7"
                    android:layout_marginBottom="16dp" />

                <Spinner
                    android:id="@+id/coopSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#1E1E1E"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/renameCoopBtn"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="✏️ Переименовать"
                        android:backgroundTint="#FF9800"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/scanQrBtn"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="📷 Сканировать QR"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Карточка подписки -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            android:background="#2C2C2C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳 Подписка"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#A5D6A7"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tariffStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тариф: Базовый (до 30.06.2026)"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/changeTariffBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="💳 Выбрать тариф"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/addCardBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="💳 Привязать карту"
                    android:backgroundTint="#673AB7"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Карточка настроек -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            android:background="#2C2C2C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Настройки"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#A5D6A7"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌙 Тёмная тема"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/themeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌐 Язык"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"/>

                    <Spinner
                        android:id="@+id/languageSpinner"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/saveProfileBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="💾 СОХРАНИТЬ НАСТРОЙКИ"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_glass"
            android:stateListAnimator="@null"
            android:elevation="4dp"
            android:letterSpacing="0.1" />

    </LinearLayout>
</ScrollView>